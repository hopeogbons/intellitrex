# Node 24.15+; run npm run model-settings:setup for interactive local setup.
# Real values belong in .env.local or the deployment's secret manager.
MODEL_CONFIG_DATABASE_ENGINE=sqlite
# Local path; production requires an absolute path on a persistent volume.
MODEL_CONFIG_DATABASE_PATH=./var/data/intellitrex.sqlite
# A random 32-byte key encoded as base64, never regenerated on deployment.
MODEL_CONFIG_ENCRYPTION_KEY=
# scrypt$<salt hex>$<hash hex>; escape $ as \$ in dotenv files.
MODEL_SETTINGS_ADMIN_PASSWORD_HASH=
# Independent random 32-byte key encoded as base64.
MODEL_SETTINGS_SESSION_SECRET=
